{
  "id": "claude.gemini.stream.parallel",
  "desc": "claude client -> gemini upstream, stream, parallel",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/messages",
        "auth": "Client",
        "headers": [],
        "body": {
          "model": "gemini-2.5-flash",
          "max_tokens": 4096,
          "messages": [
            {
              "role": "user",
              "content": "What is the weather in Paris?"
            }
          ],
          "stream": true,
          "tools": [
            {
              "name": "get_weather",
              "description": "Get the weather",
              "input_schema": {
                "type": "object",
                "properties": {
                  "city": {
                    "type": "string",
                    "description": "City name"
                  }
                },
                "required": [
                  "city"
                ]
              }
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "access-control-allow-headers": "*",
          "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
