{
  "id": "plugins.translate.response_normalizer_stream",
  "desc": "response normalizer on a streaming chat",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/chat/completions",
        "auth": "Client",
        "headers": [],
        "body": {
          "model": "compat-gpt-4o",
          "messages": [
            {
              "role": "user",
              "content": "What is the weather in Paris?"
            }
          ],
          "stream": true,
          "stream_options": {
            "include_usage": true
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "access-control-allow-headers": "*",
          "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
          "access-control-allow-origin": "*",
          "access-control-expose-headers": "X-CPA-TRACE-ID, X-CPA-VERSION, X-CPA-COMMIT, X-CPA-BUILD-DATE, X-CPA-SUPPORT-PLUGIN, X-CPA-HOME-VERSION, X-CPA-HOME-BUILD-DATE, X-SERVER-VERSION, X-SERVER-BUILD-DATE, Location, Retry-After, X-Request-Id, OpenAI-Request-Id",
          "cache-control": "no-cache",
          "connection": "keep-alive",
          "content-type": "text/event-stream",
          "x-cpa-trace-id": "<ts14>-50b3c9a0d698bde0-<uuid:1>"
        },
        "body": {
          "type": "sse",
          "events": [
            {
              "data": {
                "response_normalized_after_by": "example-response-normalizer-go"
              }
            },
            {
              "data": {
                "response_normalized_after_by": "example-response-normalizer-go"
              }
            },
            {
              "data": {
                "response_normalized_after_by": "example-response-normalizer-go"
              }
            },
            {
              "data": {
                "response_normalized_after_by": "example-response-normalizer-go"
              }
            },
            {
              "data": {
                "response_normalized_after_by": "example-response-normalizer-go"
              }
            },
            {
              "data": {
                "response_normalized_after_by": "example-response-normalizer-go"
              }
            },
            {
              "data": "[DONE]"
            }
          ]
        }
      }
    }
  ],
  "upstream": [
    {
      "family": "compat",
      "method": "POST",
      "path": "/chat/completions",
      "query": "",
      "credential": "sk-compat-2",
      "headers": {
        "accept": "text/event-stream",
        "accept-encoding": "gzip",
        "authorization": "Bearer sk-compat-2",
        "cache-control": "no-cache",
        "content-type": "application/json",
        "user-agent": "cli-proxy-openai-compat"
      },
      "body": {
        "model": "mock-gpt-4o",
        "messages": [
          {
            "role": "user",
            "content": "What is the weather in Paris?"
          }
        ],
        "stream": true,
        "stream_options": {
          "include_usage": true
        }
      }
    }
  ]
}
