          "content-type": "application/json",
          "x-cpa-trace-id": "<ts14>-f46ece6b8824823d-<uuid:1>"
        },
        "body": {
          "type": "json",
          "value": {
            "id": "msg_mock01",
            "type": "message",
            "role": "assistant",
            "model": "claude-sonnet-4-5-20250929",
            "content": [
              {
                "type": "text",
                "text": "Hello from mock"
              }
            ],
            "stop_reason": "end_turn",
