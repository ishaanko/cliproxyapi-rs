          [
            "anthropic-beta",
            "fine-grained-tool-streaming-2025-05-14"
          ]
        ],
        "body": {
          "model": "claude-sonnet-4-5-20250929",
          "max_tokens": 4096,
          "messages": [
            {
              "role": "user",
              "content": "What is the weather in Paris?"
