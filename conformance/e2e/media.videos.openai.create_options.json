        "accept-encoding": "gzip",
        "authorization": "Bearer sk-xai-1",
        "connection": "Keep-Alive",
        "content-type": "application/json",
        "user-agent": "<go-default-ua>"
      },
      "body": {
        "model": "grok-imagine-video-1.5",
        "prompt": "p",
