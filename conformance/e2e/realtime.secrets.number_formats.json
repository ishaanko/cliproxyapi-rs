{
  "id": "realtime.secrets.number_formats",
  "desc": "session numbers and nesting survive the canonical re-encoding",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/realtime/client_secrets",
        "auth": "Client",
        "headers": [],
        "body": "{\"session\":{\"temperature\":0.8,\"max_response_output_tokens\":4096,\"n\":1e3,\"big\":12345678901234567890,\"tools\":[{\"type\":\"function\",\"name\":\"x\",\"parameters\":{\"b\":1,\"a\":2}}],\"flag\":true,\"nothing\":null}}"
      },
      "response": {
        "status": 200,
        "headers": {
          "access-control-allow-headers": "*",
          "access-control-allow-methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
          "access-control-allow-origin": "*",
          "access-control-expose-headers": "X-CPA-TRACE-ID, X-CPA-VERSION, X-CPA-COMMIT, X-CPA-BUILD-DATE, X-CPA-SUPPORT-PLUGIN, X-CPA-HOME-VERSION, X-CPA-HOME-BUILD-DATE, X-SERVER-VERSION, X-SERVER-BUILD-DATE, Location, Retry-After, X-Request-Id, OpenAI-Request-Id",
          "cache-control": "no-store",
          "content-type": "application/json; charset=utf-8"
        },
        "body": {
          "type": "json",
          "value": {
            "value": "<volatile>",
            "expires_at": "<now>",
            "session": {
              "big": 12345678901234567000,
              "expires_at": "<now>",
              "flag": true,
              "id": "<volatile>",
              "max_response_output_tokens": 4096,
              "model": "gpt-realtime",
              "n": 1000,
              "nothing": null,
              "object": "realtime.session",
              "temperature": 0.8,
              "tools": [
                {
                  "name": "x",
                  "parameters": {
                    "a": 2,
                    "b": 1
                  },
                  "type": "function"
                }
              ],
              "type": "realtime"
            }
          }
        }
      }
    }
  ],
  "upstream": [],
  "volatile": [
    "/steps/0/response/body/value/session/id",
    "/steps/0/response/body/value/value"
  ]
}
