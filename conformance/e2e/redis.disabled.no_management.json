{
  "id": "redis.disabled.no_management",
  "desc": "without a management secret the RESP connection is closed",
  "steps": [
    {
      "request": {
        "method": "RESP",
        "acts": "[Cmd([\"PING\"])]"
      },
      "response": {
        "status": 0,
        "headers": {},
        "body": {
          "type": "json",
          "value": [
            {
              "sent": [
                "PING"
              ],
              "closed": true
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "RESP",
        "acts": "[Cmd([\"AUTH\", \"e2e-mgmt-secret\"])]"
      },
      "response": {
        "status": 0,
        "headers": {},
        "body": {
          "type": "json",
          "value": [
            {
              "sent": [
                "AUTH",
                "e2e-mgmt-secret"
              ],
              "closed": true
            }
          ]
        }
      }
    }
  ],
  "upstream": []
}
