{
  "id": "redis.pop.arguments",
  "desc": "LPOP/RPOP argument and channel validation",
  "steps": [
    {
      "request": {
        "method": "RESP",
        "acts": "[Cmd([\"AUTH\", \"e2e-mgmt-secret\"]), Cmd([\"LPOP\"]), Cmd([\"LPOP\", \"usage\", \"1\", \"2\"]), Cmd([\"RPOP\", \"usage\", \"0\"]), Cmd([\"RPOP\", \"usage\", \"-3\"]), Cmd([\"RPOP\", \"usage\", \"many\"]), Cmd([\"LPOP\", \"errors\"]), Cmd([\"RPOP\", \" USAGE \", \"2\"]), Cmd([\"RPOP\", \"nope\", \"2\"])]"
      },
      "response": {
        "status": 0,
        "headers": {},
        "body": {
          "type": "json",
          "value": [
            {
              "sent": [
                "AUTH",
                "e2e-mgmt-secret"
              ],
              "reply": {
                "simple": "OK"
              }
            },
            {
              "sent": [
                "LPOP"
              ],
              "reply": {
                "error": "ERR wrong number of arguments for 'lpop' command"
              }
            },
            {
              "sent": [
                "LPOP",
                "usage",
                "1",
                "2"
              ],
              "reply": {
                "error": "ERR wrong number of arguments for 'lpop' command"
              }
            },
            {
              "sent": [
                "RPOP",
                "usage",
                "0"
              ],
              "reply": {
                "error": "ERR value is not an integer or out of range"
              }
            },
            {
              "sent": [
                "RPOP",
                "usage",
                "-3"
              ],
              "reply": {
                "error": "ERR value is not an integer or out of range"
              }
            },
            {
              "sent": [
                "RPOP",
                "usage",
                "many"
              ],
              "reply": {
                "error": "ERR value is not an integer or out of range"
              }
            },
            {
              "sent": [
                "LPOP",
                "errors"
              ],
              "reply": {
                "error": "ERR unsupported channel 'errors'"
              }
            },
            {
              "sent": [
                "RPOP",
                " USAGE ",
                "2"
              ],
              "reply": []
            },
            {
              "sent": [
                "RPOP",
                "nope",
                "2"
              ],
              "reply": {
                "error": "ERR unsupported channel 'nope'"
              }
            }
          ]
        }
      }
    }
  ],
  "upstream": []
}
